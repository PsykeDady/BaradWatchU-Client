{
  "schemaVersion": "baradwatchu.audit-policy.v3",
  "id": "cp5-local-password-baseline",
  "checks": {
    "SEC-001": { "enabled": false },
    "SEC-006": { "enabled": false },
    "SEC-007": { "enabled": false },
    "SEC-012": { "enabled": false },
    "SEC-013": { "enabled": false },
    "SEC-014": { "enabled": false },
    "SEC-008": { "maximumDays": 60, "minimumDays": 1 },
    "SEC-009": { "minimumDays": 10 },
    "SEC-010": {
      "minimumLength": 14,
      "minimumClasses": 4,
      "minimumUppercase": 1,
      "minimumLowercase": 1,
      "minimumDigits": 1,
      "minimumSpecial": 1
    }
  }
}
