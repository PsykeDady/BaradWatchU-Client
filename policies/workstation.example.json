{
  "schemaVersion": "baradwatchu.workstation-policy.v1",
  "nativePolicy": {
    "schemaVersion": "baradwatchu.audit-policy.v3",
    "id": "workstation-example",
    "checks": {
      "SEC-001": {},
      "SEC-006": { "mandatory": false },
      "SEC-007": { "maxTimeoutSeconds": 300, "requireImmediatePassword": true },
      "SEC-008": { "maximumDays": 60, "minimumDays": 1 },
      "SEC-009": { "minimumDays": 10 },
      "SEC-010": { "minimumLength": 14, "minimumClasses": 4, "minimumUppercase": 1, "minimumLowercase": 1, "minimumDigits": 1, "minimumSpecial": 1 },
      "SEC-012": { "mandatory": false },
      "SEC-013": { "mandatory": false },
      "SEC-014": { "mandatory": false },
      "SEC-015": {},
      "SEC-016": { "enabled": false },
      "SEC-017": { "mandatory": false }
    }
  },
  "supplemental": {
    "SEC-003": { "enabled": true, "mandatory": true },
    "SEC-004": { "enabled": true, "mandatory": true },
    "SEC-011": { "enabled": true, "mandatory": false }
  }
}
