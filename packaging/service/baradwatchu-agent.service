# BaradWatchU Client system service (Milestone 2): mutual-TLS listener for remote audit
# requests and local IPC endpoint for the per-user agents. It never audits by itself.
# Installed by packaging/service/install-service.sh (@AGENT@ is replaced there).
# The remote listener stays off until the operator writes /var/lib/baradwatchu/service.json.
[Unit]
Description=BaradWatchU Client service (remote audit requests)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@AGENT@ service run
Restart=on-failure
RestartSec=5
RuntimeDirectory=baradwatchu
RuntimeDirectoryMode=0755
StateDirectory=baradwatchu
StateDirectoryMode=0700
UMask=0077
# Root only to read the owner-only identity files of users who registered; everything
# else is taken away.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
